# CampusCart Backend Environment Variables
DJANGO_SECRET_KEY=campuscart-local-dev-change-this-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
